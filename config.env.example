# Copy this file to `config.env` (same folder) and fill in your values.
# config.env holds secrets — keep it private (chmod 600).

# Your Gmail address
GMAIL_ADDRESS=you@gmail.com

# Gmail App Password (16 chars, no spaces). Requires 2-Step Verification enabled.
# Create at: https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# One or more ICS calendar URLs. Comma- or newline-separated.
# webcal:// links are accepted and auto-converted to https://
ICS_URL=https://p123-caldav.icloud.com/published/2/XXXXXXXX

# Where the briefing is sent (defaults to GMAIL_ADDRESS if blank)
BRIEFING_TO=

# IANA timezone, e.g. Europe/Chisinau, America/New_York.
# Leave blank to use the machine's local timezone.
TIMEZONE=

# Max unread emails to include
MAX_EMAILS=12
